  "lines": [
    {"who": "moozi",  "from": 0.6,  "to": 3.0,  "text": "نه نه نه! پیجم!"},
    {"who": "moozi",  "from": 6.0,  "to": 8.7,  "text": "کرمو! جواب بده! پیجمو پس بده!"},
    {"who": "kermo",  "from": 9.5,  "to": 11.9, "text": "تیکتت در حال بررسیه... برای همیشه!"},
    {"who": "ananas", "from": 12.9, "to": 16.1, "text": "پیجی که امنیت نداره، سفیر برند من نمیشه."},
    {"who": "ananas", "from": 16.4, "to": 17.3, "text": "موزی حذف!"},
    {"who": "holu",   "from": 18.6, "to": 21.6, "text": "اگه منم ببازم چی؟ فقط دو روز مونده..."},
    {"who": "kermo",  "from": 22.8, "to": 26.0, "text": "خانم هلو... تخفیف ویژه! فقط رمزت رو بفرست."},
    {"who": "tooti",  "from": 30.6, "to": 32.1, "text": "دیوونه شدی؟!"},
    {"who": "holu",   "from": 32.6, "to": 33.8, "text": "توتی؟!"},
    {"who": "tooti",  "from": 34.2, "to": 36.1, "text": "بیا. راه درستشو نشونت میدم."}
