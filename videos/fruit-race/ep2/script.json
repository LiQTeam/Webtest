    {"who": "holu",   "from": 16.9, "to": 20.1, "text": "یه دستور دیگه... شاید این یکی دیده بشه."},
    {"who": "holu",   "from": 22.1, "to": 24.4, "text": "صد و چهل تا... فقط."},
    {"who": "kermo",  "from": 25.9, "to": 29.6, "text": "هه‌هه! رمزها مال من، پول‌ها هم مال من!"},
    {"who": "moozi",  "from": 33.0, "to": 34.3, "text": "...چی؟!"}
