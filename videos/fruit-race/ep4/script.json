  "title": {"from": 3.5, "to": 5.5, "text": "قسمت ۴ · راه درست"},
  "end": {"from": 41.2, "t1": "ادامه دارد...", "t2": "قسمت آخر · سفیر", "t3": "فالو کن که قسمت آخر رو از دست ندی"},
  "flashes": [0.35],
  "lines": [
    {"who": "tooti",  "from": 0.45, "to": 3.2,  "text": "قانون اول: هیچ‌کس نباید رمزت رو بخواد!"},
    {"who": "holu",   "from": 5.9,  "to": 7.9,  "text": "پس چطوری دیده بشم؟"},
    {"who": "tooti",  "from": 8.3,  "to": 10.8, "text": "محتوای خوب داری. فقط یه کم دیده‌شدن لازمه."},
    {"who": "tooti",  "from": 11.3, "to": 13.9, "text": "قیمت و حداقل و حداکثر رو قبل از پرداخت می‌بینی."},
    {"who": "holu",   "from": 14.4, "to": 15.8, "text": "رمز نمی‌خواد؟"},
    {"who": "tooti",  "from": 16.3, "to": 18.3, "text": "فقط لینک عمومی پیجت. همین!"},
    {"who": "holu",   "from": 23.9, "to": 26.0, "text": "پولمم خودش برگشت؟!"},
    {"who": "tooti",  "from": 26.5, "to": 28.9, "text": "آره، خودکار و با رسید. همه‌چی شفاف."},
    {"who": "ananas", "from": 37.8, "to": 40.6, "text": "فردا... برنده رو اعلام می‌کنم."}
  ],
